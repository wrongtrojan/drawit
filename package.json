{
  "name": "drawit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "mcp": "pnpm --silent --filter @drawit/mcp start",
    "build:mcp": "pnpm --filter @drawit/mcp build",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "build:desktop": "node scripts/icons.mjs && pnpm bundle:runtime && pnpm --filter @drawit/desktop build",
    "test:runtime": "node scripts/check-runtime.mjs",
    "package:dmg": "node scripts/package-dmg.mjs",
    "examples:evolution": "pnpm --filter @drawit/mcp exec tsx ../../scripts/write-evolution-examples.ts"
  }
}
